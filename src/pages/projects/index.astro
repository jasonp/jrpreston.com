---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const archivedWriting = (await getCollection('writing', ({ data }) => data.archive === true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

interface ProjectSection {
  id: string;
  title: string;
  era: string;
  description: string;
  /** Meta strip at bottom — count, pill, etc. */
  meta?: string;
  /** Link destination (internal path or external URL) */
  href: string | null;
  /** Link label (e.g. "Enter the archive →") */
  linkText?: string;
  /** External link opens in new tab */
  external?: boolean;
  /** Shown as a pill instead of a link */
  statusPill?: string;
  /** Supplementary note below meta */
  note?: string;
}

const sections: ProjectSection[] = [
  {
    id: 'writing-wp',
    title: 'WordPress Blog',
    era: '2005 — 2011',
    description:
      "Long-form posts from the WordPress years. Some about technology, some about events, some about whatever I was thinking about that morning. A few are still good. A few are very of their time.",
    meta: archivedWriting.length > 0 ? `${archivedWriting.length} posts` : undefined,
    href: archivedWriting.length > 0 ? '/projects/writing/' : null,
    linkText: archivedWriting.length > 0 ? 'Enter the archive →' : undefined,
    statusPill: archivedWriting.length === 0 ? 'In progress' : undefined,
    note:
      archivedWriting.length > 0
        ? undefined
        : "Migration in progress. Pulling from a 2011 WordPress SQL dump (~1,800 posts across two blogs) and revising to a curated set.",
  },
  {
    id: 'ladderverse',
    title: 'Ladderverse',
    era: 'Live · Since 2024',
    description:
      "A daily word-ladder puzzle. Start with one word, change one letter at a time to reach the next, score against the optimal path. One puzzle every day, simple to learn, hard to master.",
    href: 'https://ladderverse.com',
    linkText: 'Play at ladderverse.com →',
    external: true,
  },
];
---

<BaseLayout
  title="Projects — Jason Preston"
  description="I can't help myself, I make things."
>
  <section class="section">
    <header class="section-header">
      <div class="eyebrow">I can't help myself. I make things.</div>
      <h1>Projects</h1>
      <p class="dek">"Do you like it? You don't like it? OK... I'll put it in the garage."</p>
      <p class="dek attribution">— Eddie Izzard</p>
    </header>

    <div class="archive-grid">
      {sections.map((s) => (
        <article class="project-card">
          <header>
            <div class="era">{s.era}</div>
            <h2>{s.title}</h2>
          </header>
          <p class="desc">{s.description}</p>
          <div class="meta">
            {s.statusPill ? (
              <>
                <span class="status-pill">{s.statusPill}</span>
                {s.note && <p class="note">{s.note}</p>}
              </>
            ) : (
              <>
                {s.meta && <span class="count">{s.meta}</span>}
                {s.href && (
                  <a
                    href={s.href}
                    class="enter"
                    target={s.external ? '_blank' : undefined}
                    rel={s.external ? 'noopener noreferrer' : undefined}
                  >
                    {s.linkText ?? 'Visit →'}
                  </a>
                )}
              </>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 4rem 2rem 4rem;
  }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .eyebrow {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
    font-weight: 400;
    letter-spacing: -.03em;
    line-height: 1;
    margin: 0 0 1rem;
  }
  .dek {
    color: var(--muted);
    font-size: 1.05rem;
    font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0;
    font-style: italic;
    max-width: 50ch;
    margin: 0 auto;
    line-height: 1.5;
  }
  .dek.attribution {
    font-size: .9rem;
    color: var(--faint);
    margin-top: .25rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .project-card {
    border: 1px solid var(--rule);
    padding: 2rem 2rem 2rem;
    background: transparent;
    transition: border-color .15s, background .15s;
  }
  .project-card:hover { border-color: var(--accent); }

  .project-card .era {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-feature-settings: "tnum";
    margin-bottom: .35rem;
  }
  .project-card h2 {
    font-size: 2rem;
    font-variation-settings: "opsz" 80, "SOFT" 30, "WONK" 0;
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: 1;
    margin: 0 0 1rem;
  }
  .project-card .desc {
    color: var(--muted);
    font-size: .98rem;
    line-height: 1.55;
    margin: 0 0 1.5rem;
  }
  .project-card .meta {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: .85rem;
  }
  .project-card .count {
    color: var(--ink);
    font-feature-settings: "tnum";
    margin-right: 1.5rem;
  }
  .project-card .enter {
    color: var(--accent);
    font-weight: 500;
    border: none;
  }
  .project-card .enter:hover { color: var(--ink); }
  .project-card .status-pill {
    display: inline-block;
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: .2rem .6rem;
    border-radius: 999px;
    font-weight: 500;
    font-feature-settings: "tnum";
  }
  .project-card .note {
    margin: .85rem 0 0;
    font-size: .82rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .section { padding: 2rem 1.25rem 3rem; }
    .project-card { padding: 1.5rem; }
  }
</style>
