---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<BaseLayout title="Jason Preston" noChrome>
  <div class="home-toggle">
    <ThemeToggle />
  </div>

  <section class="home">
    <h1 class="name anim a1">Jason Preston</h1>
    <p class="tagline anim a2">Writer, VC, curious person. Co-founded <a href="https://dentthefuture.com">Dent</a> in 2012. Now starting up <a href="https://tkmt.vc">TK Ventures</a>. Based in Seattle.</p>

    <figure class="photo anim a3">
      <img src="/images/crepuscular-longs.jpg" alt="Crepuscular rays over Longs Peak, Colorado" width="2048" height="1366" loading="eager" />
      <figcaption>Crepuscular rays · Longs Peak · Rocky Mountain N.P.</figcaption>
    </figure>
    <nav class="home-nav anim a4">
      <a href="https://jasonp.substack.com/" class="nav-link">
        <span class="nav-label">Substack</span>
        <span class="nav-meta">Thinking in Public</span>
      </a>
      <a href="/writing/" class="nav-link">
        <span class="nav-label">Writing</span>
        <span class="nav-meta">Essays &amp; pieces</span>
      </a>
      <a href="/projects/" class="nav-link">
        <span class="nav-label">Projects</span>
        <span class="nav-meta">Tinkering</span>
      </a>
      <a href="/about/" class="nav-link">
        <span class="nav-label">About</span>
        <span class="nav-meta">A curious life</span>
      </a>
      <a href="https://www.flickr.com/photos/jasonp107/" class="nav-link">
        <span class="nav-label">Photography</span>
        <span class="nav-meta">On Flickr</span>
      </a>
    </nav>

    <footer class="home-foot anim a6">
      <a href="mailto:jason@jrpreston.com">jason@jrpreston.com</a>
      <span class="sep">·</span>
      <a href="https://www.alsop-louie.com/team/jason-preston/">Professional bio</a>
      <span class="sep">·</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </section>
</BaseLayout>

<style>
  /* ── entrance ──────────────────────────────────────────
     Subtle staggered fade. No transforms, no bounce.
     Feels deliberate, not animated. Respects reduced motion. */
  .anim {
    opacity: 0;
    animation: appear .6s ease forwards;
  }
  .a1 { animation-delay: .05s; }
  .a2 { animation-delay: .15s; }
  .a3 { animation-delay: .25s; }
  .a4 { animation-delay: .4s; }
  .a5 { animation-delay: .5s; }
  .a6 { animation-delay: .55s; }

  @keyframes appear {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim { opacity: 1; animation: none; }
  }

  /* ── toggle ────────────────────────────────────────── */
  .home-toggle {
    max-width: 820px;
    margin: 1.5rem auto 0;
    padding: 0 2.5rem;
    text-align: right;
  }

  /* ── name + tagline ────────────────────────────────── */
  .home {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }

  .name {
    font-family: "Literata", ui-serif, Georgia, serif;
    font-variation-settings: "opsz" 72;
    font-size: clamp(3.2rem, 8vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: .92;
    margin-top: 6rem;
  }

  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0;
    font-style: italic;
    max-width: 42ch;
    margin: 1.75rem auto 0;
    line-height: 1.5;
  }
  .tagline a {
    color: var(--muted);
    border-bottom-color: var(--faint);
    transition: color .15s, border-color .15s;
  }
  .tagline a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── photograph ────────────────────────────────────────
     The photo breaks wider than the text column. It's the
     emotional center of the page and earns the extra space.
     No hard border — a faint ambient shadow lifts it off
     the dark paper. */
  .photo {
    margin: 3.5rem 0 0;
  }
  .photo img {
    width: 100%;
    display: block;
    border: 1px solid var(--rule);
  }
  .photo figcaption {
    font-size: .72rem;
    color: var(--faint);
    text-align: right;
    margin-top: .85rem;
    font-feature-settings: "tnum";
    letter-spacing: .02em;
  }

  /* ── nav ────────────────────────────────────────────── */
  .home-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .nav-link {
    display: block;
    color: var(--ink);
    border: none;
    text-align: center;
    position: relative;
    padding-bottom: .5rem;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width .2s ease, left .2s ease;
  }
  .nav-link:hover::after {
    width: 100%;
    left: 0;
  }
  .nav-link:hover .nav-label { color: var(--accent); }

  .nav-label {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -.005em;
    transition: color .15s;
  }
  .nav-meta {
    display: block;
    font-size: .65rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: .14em;
    margin-top: .3rem;
    font-weight: 400;
    font-feature-settings: "tnum";
    transition: color .15s;
  }
  .nav-link:hover .nav-meta { color: var(--muted); }

  /* ── latest ────────────────────────────────────────── */
  .latest {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    font-size: .88rem;
    color: var(--muted);
    font-feature-settings: "tnum";
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: .5rem;
    flex-wrap: wrap;
  }
  .latest-arrow {
    color: var(--accent);
    font-size: .75rem;
  }
  .latest a {
    color: var(--ink);
    font-weight: 500;
    border: none;
    transition: color .15s;
  }
  .latest a:hover { color: var(--accent); }
  .latest-date {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: .72rem;
  }

  /* ── footer ────────────────────────────────────────── */
  .home-foot {
    margin-top: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--rule);
    color: var(--faint);
    font-size: .82rem;
    display: flex;
    justify-content: center;
    gap: .75rem;
    flex-wrap: wrap;
  }
  .home-foot a {
    color: var(--faint);
    border: none;
    transition: color .15s;
  }
  .home-foot a:hover { color: var(--accent); }
  .sep { color: var(--rule); }

  /* ── responsive ────────────────────────────────────── */
  @media (max-width: 640px) {
    .home-toggle { padding: 0 1.25rem; }
    .home { padding: 0 1.25rem; }
    .photo { padding: 0 1rem; }
    .name { margin-top: 4rem; }
    .home-nav { gap: 2rem; }
    .home-foot { gap: .5rem; }
  }
</style>
