---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Pull the most recent daily post for the optional "Latest" line.
// If there's nothing recent (or the daily collection is empty),
// the line just doesn't render and the page still feels complete.
const dailyPosts = (await getCollection('daily', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = dailyPosts[0];

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
---

<BaseLayout title="Jason Preston" noChrome>
  <section class="home">
    <h1 class="name">Jason Preston</h1>
    <p class="tagline">Writer, investor, curious person. Co-founded <a href="https://dentthefuture.com">Dent</a> in 2012. Partner at <a href="https://alsop-louie.com">Alsop Louie</a> since 2019. Seattle.</p>

    <figure class="photo-frame">
      <img src="/images/crepuscular-longs.jpg" alt="Crepuscular rays over Longs Peak, Colorado" width="2048" height="1366" />
      <figcaption>Crepuscular rays · Longs Peak · Rocky Mountain N.P.</figcaption>
    </figure>

    <nav class="home-nav">
      <a href="/daily/"><span class="label">Daily</span><span class="meta">An AI experiment</span></a>
      <a href="/writing/"><span class="label">Writing</span><span class="meta">Essays &amp; pieces</span></a>
      <a href="/archive/"><span class="label">Archive</span><span class="meta">Older work</span></a>
      <a href="/about/"><span class="label">About</span><span class="meta">A curious life</span></a>
      <a href="https://www.flickr.com/photos/jasonp107/"><span class="label">Photography</span><span class="meta">On Flickr</span></a>
      <a href="/rss.xml"><span class="label">Feed</span><span class="meta">RSS / Atom</span></a>
    </nav>

    {latest && (
      <div class="latest-line">
        <span class="arrow">→</span>
        Latest:
        <a href={`/daily/${latest.id.replace(/\.mdx?$/, '')}/`}>{latest.data.title}</a>
        <span class="date"> · {dateFmt(latest.data.pubDate)}</span>
      </div>
    )}

    <div class="home-bio">
      Reach me at <a href="mailto:jason@prestons.me">jason@prestons.me</a>. Full bio over at <a href="https://www.alsop-louie.com/team/jason-preston/">Alsop Louie</a>.
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    max-width: 820px;
    margin: 4rem auto 6rem;
    padding: 0 2rem;
    text-align: center;
  }
  .name {
    font-size: clamp(3rem, 7vw, 5rem);
    /* Use the text-grade Fraunces axes (lower opsz, SOFT 0) on the home name
       to keep the J neutral. Other headlines still use the display-grade
       opsz 144, SOFT 30 settings. */
    font-variation-settings: "opsz" 60, "SOFT" 0, "WONK" 0;
    font-weight: 400;
    letter-spacing: -.025em;
    line-height: .95;
    margin-top: 4rem;
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--muted);
    margin-top: 1.25rem;
    font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0;
    font-style: italic;
    max-width: 50ch;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.45;
  }
  .tagline a { color: var(--muted); border-bottom-color: var(--rule); }
  .tagline a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .photo-frame {
    margin: 3.5rem auto 1rem;
    max-width: 820px;
  }
  .photo-frame img {
    width: 100%;
    border: 1px solid var(--rule);
  }
  .photo-frame figcaption {
    font-size: .75rem;
    color: var(--muted);
    text-align: center;
    margin-top: .85rem;
    font-feature-settings: "tnum";
    letter-spacing: .02em;
  }

  .home-nav {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .home-nav a {
    font-size: .95rem;
    color: var(--ink);
    border: none;
    font-weight: 500;
    letter-spacing: -.005em;
    transition: color .15s;
  }
  .home-nav a:hover { color: var(--accent); }
  .home-nav .label { display: block; }
  .home-nav .meta {
    display: block;
    font-size: .68rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .14em;
    margin-top: .25rem;
    font-weight: 400;
    font-feature-settings: "tnum";
  }

  .latest-line {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    font-size: .9rem;
    color: var(--muted);
    font-feature-settings: "tnum";
  }
  .latest-line a {
    color: var(--ink);
    font-weight: 500;
    border: none;
  }
  .latest-line a:hover { color: var(--accent); }
  .latest-line .arrow { color: var(--accent); margin-right: .3rem; }
  .latest-line .date { color: var(--muted); }

  .home-bio {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: .95rem;
    line-height: 1.6;
    max-width: 50ch;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 600px) {
    .home { padding: 0 1.25rem; margin-top: 2rem; }
    .name { margin-top: 2rem; }
    .home-nav { gap: 1.5rem; }
  }
</style>
