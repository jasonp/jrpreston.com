---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreadsAbout from '../components/ThreadsAbout.svelte';
---

<BaseLayout
  title="About — Jason Preston"
  description="A curious life. Writer, investor, twiddler of thumbs, magician, and tennis hack."
>
  <section class="about">
    <header class="about-header">
      <div class="eyebrow">About</div>
      <h1>A curious life.</h1>
      <p class="tagline">Writer, investor, twiddler of thumbs, magician, and tennis hack.</p>
    </header>

    <ThreadsAbout client:load />
  </section>
</BaseLayout>

<style>
  .about {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
  }
  .about-header { text-align: center; margin-bottom: 3rem; }
  .eyebrow {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
    font-weight: 400;
    letter-spacing: -.03em;
    line-height: 1;
    margin: 0 auto 1rem;
    max-width: 16ch;
  }
  .tagline {
    color: var(--muted);
    font-size: 1.1rem;
    font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0;
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 600px) {
    .about { padding: 2rem 1.25rem 3rem; }
  }
</style>
