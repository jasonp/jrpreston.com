---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noChrome?: boolean;
}

const {
  title = 'Jason Preston',
  description = "Writer, investor, curious person. Co-founded Dent in 2012. Partner at Alsop Louie since 2019. Seattle.",
  image = '/images/crepuscular-longs.jpg',
  noChrome = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts: Fraunces (display+body) and JetBrains Mono (metadata) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- RSS feeds -->
    <link rel="alternate" type="application/rss+xml" title="jrpreston.com — all" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="jrpreston.com — daily" href="/daily/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="jrpreston.com — writing" href="/writing/rss.xml" />

    <!-- Apply persisted theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('jp-theme');
          if (stored === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    {!noChrome && <Header />}
    <main>
      <slot />
    </main>
    {!noChrome && <Footer />}
  </body>
</html>
