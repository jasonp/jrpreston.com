---
// Theme toggle. Dark is the default state (no data-theme attribute).
// Click flips to data-theme="light", persisted in localStorage as "jp-theme".
// The inline script in BaseLayout.astro applies the persisted choice before
// first paint to avoid a flash.
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light/dark mode">
  <span class="label-dark">Light</span>
  <span class="label-light">Dark</span>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: inherit;
    font-size: .75rem;
    padding: .35rem .8rem;
    border-radius: 999px;
    cursor: pointer;
    letter-spacing: .02em;
    transition: border-color .15s, color .15s;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .label-light { display: none; }
  [data-theme="light"] .label-dark { display: none; }
  [data-theme="light"] .label-light { display: inline; }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
        try { localStorage.setItem('jp-theme', 'dark'); } catch (e) {}
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        try { localStorage.setItem('jp-theme', 'light'); } catch (e) {}
      }
    });
  })();
</script>
