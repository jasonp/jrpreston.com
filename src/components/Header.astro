---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="chrome">
  <a class="mark" href="/">Jason Preston</a>
  <div class="meta">
    <nav class="nav">
      <a href="/daily/">Daily</a>
      <a href="/writing/">Writing</a>
      <a href="/projects/">Projects</a>
      <a href="/about/">About</a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .chrome {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .mark {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-variation-settings: "opsz" 14, "SOFT" 0, "WONK" 0;
    font-weight: 500;
    letter-spacing: -.005em;
    color: var(--muted);
    border: none;
  }
  .mark:hover { color: var(--accent); }
  .meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
  }
  .nav a {
    font-size: .85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .12em;
    border: none;
    font-weight: 500;
  }
  .nav a:hover { color: var(--accent); }

  @media (max-width: 600px) {
    .chrome { padding: 1.25rem 1.25rem; }
    .meta { gap: 1rem; }
    .nav { gap: 1rem; }
    .nav a { font-size: .78rem; letter-spacing: .1em; }
  }
</style>
