---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="row">
    <div>jrpreston.com · {year} · Seattle</div>
    <div class="links">
      <a href="/rss.xml">RSS</a>
      <a href="mailto:jason@prestons.me">Email</a>
      <a href="https://www.flickr.com/photos/jasonp107/">Photography</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    max-width: var(--maxw);
    margin: 6rem auto 2rem;
    padding: 2rem 2rem;
    border-top: 1px solid var(--rule);
    font-size: .8rem;
    color: var(--muted);
    font-feature-settings: "tnum";
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .links { display: flex; gap: 1.5rem; }
  .links a { color: var(--muted); border: none; }
  .links a:hover { color: var(--accent); }
</style>
